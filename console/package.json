{
  "name": "@sandbox-platform/console",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24.19.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "test": "node --experimental-transform-types --test tests/*.test.ts",
    "test:browser": "playwright test",
    "preview": "vite preview --host 127.0.0.1",
    "format": "prettier --write src tests scripts vite.config.ts playwright.config.ts tsconfig.json package.json",
    "format:check": "prettier --check src tests scripts vite.config.ts playwright.config.ts tsconfig.json package.json"
  },
  "dependencies": {
    "openapi-fetch": "0.17.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "prettier": "3.9.9",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "8.3.3"
  }
}
