# syntax=docker/dockerfile:1@sha256:4edf897a3ffa55b89f906fc8cc78afdb3f1834cc9c7083565e611a8a7d5fe99e
FROM rust:1.98.1-bookworm@sha256:93ce27a88655056a51dbdd8f5f2d7ddc071c7b0070fb288a37b5a285fc83971e AS build
WORKDIR /build
COPY haproxy.tar.gz haproxy.sha256 ./
RUN sha256sum -c haproxy.sha256 && tar -xzf haproxy.tar.gz \
    && make -C haproxy-3.2.25 -j2 TARGET=linux-glibc USE_OPENSSL=1 USE_THREAD=1 \
    && mkdir /out && cp haproxy-3.2.25/haproxy /out/ \
    && cp /usr/lib/$(gcc -print-multiarch)/libssl.so.3 /usr/lib/$(gcc -print-multiarch)/libcrypto.so.3 /out/
FROM debian:bookworm-slim@sha256:3783cc01769c7b2b1b83a5c5ad96c815348e28ed7da68e2e3687004faa906251
COPY --from=build --chmod=0555 /out/haproxy /usr/local/sbin/haproxy
COPY --from=build /out/libssl.so.3 /out/libcrypto.so.3 /usr/local/lib/
RUN ldconfig && /usr/local/sbin/haproxy -v
USER 10001:10001
STOPSIGNAL SIGUSR1
ENTRYPOINT ["/usr/local/sbin/haproxy"]
CMD ["-W", "-db", "-f", "/usr/local/etc/haproxy/haproxy.cfg"]
