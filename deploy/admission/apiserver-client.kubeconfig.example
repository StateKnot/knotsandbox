apiVersion: v1
kind: Config
users:
  # Matches service.namespace.svc for port 443. This is the API server's outgoing
  # webhook identity, not the identity of the original Pod/PVC caller.
  - name: sandbox-admission.sandbox-system.svc
    user:
      client-certificate: /etc/kubernetes/pki/sandbox-webhook-client.crt
      client-key: /etc/kubernetes/pki/sandbox-webhook-client.key
