{
  "api_version": "v1",
  "build_version": "0.1.0",
  "project_id": "00000000-0000-4000-8000-000000000002",
  "api_features": {
    "instance_lifecycle": true,
    "instance_details": true,
    "instance_security": true,
    "project_grants": true,
    "service_client_registry": true,
    "execution_acceptance": true,
    "execution_metadata": true,
    "execution_hard_cancellation": true,
    "operation_history": true,
    "domain_event_history": true,
    "audit_history": true,
    "file_transfer": false,
    "terminal_sessions": false,
    "execution_output_download": false,
    "execution_output_streaming": false,
    "monitoring": false,
    "runtime_metrics": false,
    "control_plane_diagnoses": true,
    "health_diagnostics": false,
    "scheduled_tasks": true,
    "event_automation": true,
    "automation_notifications": true,
    "backup_restore": false
  },
  "flavors": [{"name": "cpu1-mem2", "cpu_millis": 1000, "memory_mib": 2048}],
  "limits": {
    "ttl_seconds": {"minimum": 60, "maximum": 86400, "configured_default": 300, "explicit_value_required": false},
    "workspace_gib": {"minimum": 1, "maximum": 1024},
    "history_page_size": {"minimum": 1, "maximum": 100},
    "management_body_bytes": 65536,
    "execution_timeout_seconds": {"minimum": 1, "maximum": 3600},
    "execution_output_bytes_max": 1048576,
    "active_execution_slots_per_instance": 1
  },
  "runtime_certification": "NOT_ASSERTED",
  "automation": {
    "schema_version": 1,
    "supported_actions": ["START", "STOP", "RESTART", "DELETE", "RENEW", "EXECUTE", "BACKUP"],
    "supported_triggers": ["ONCE", "CRON_UTC", "EVENT"],
    "clock": "POSTGRESQL",
    "time_zone": "UTC",
    "cron": {"field_count": 7, "seconds_field": "0", "year_field": "*", "day_of_month_and_week": "INTERSECTION"},
    "missed_run_policy": "AT_MOST_ONE_WITHIN_GRACE_ELSE_SKIP_SPAN",
    "skipped_runs_consume_budget": true,
    "known_automated_events_retrigger": false,
    "outcome_unknown_policy": "RECONCILE_ORIGINAL_ONLY",
    "limits": {
      "run_budget": {"minimum": 1, "maximum": 10000},
      "minimum_interval_seconds": {"minimum": 60, "maximum": 86400},
      "grace_seconds": {"minimum": 1, "maximum": 3600},
      "delegation_lifetime_seconds": {"exclusive_minimum": 60, "maximum": 31622400},
      "live_policies_per_project": 100,
      "live_policies_per_tenant": 1000,
      "name_bytes_max": 128,
      "cron_expression_bytes_max": 128,
      "event_type_bytes_max": 128
    },
    "assurance": "API_CONTRACT_ONLY"
  }
}
