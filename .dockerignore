# Build context allowlist: local credentials and developer tooling never enter it.
**
!Cargo.toml
!Cargo.lock
!rust-toolchain.toml
!build.rs
!.dockerignore
!vendor/
vendor/**
!vendor/sqlx-postgres/
vendor/sqlx-postgres/**
!vendor/sqlx-postgres/**
!vendor/containerd/
vendor/containerd/**
!vendor/containerd/v2.3.5/
!vendor/containerd/v2.3.5/**
!vendor/protobuf/
vendor/protobuf/**
!vendor/protobuf/protoc-bin-vendored-3.2.0/
!vendor/protobuf/protoc-bin-vendored-3.2.0/**
!src/
src/**
!src/**
!migrations/
migrations/**
!migrations/**
!scripts/
scripts/**
!scripts/verify-sqlx-postgres-patch.py
!scripts/sql/
scripts/sql/**
!scripts/sql/*.sql
!.sqlx/
.sqlx/**
!.sqlx/**

# Runtime enrollment validates against this reviewed, nonsecret version lock.
!deploy/
deploy/**
!deploy/cluster/
deploy/cluster/**
!deploy/cluster/versions.lock.json

# Exact nonsecret release inputs required by production compile/runtime inventory.
!deploy/backup/
deploy/backup/**
!deploy/backup/versions.lock.json
!scripts/release/
scripts/release/**
!scripts/release/debian-security.lock.json
!scripts/release/native-security.lock.json
!scripts/release/sqlite_build.py
!scripts/release/common.py
!scripts/release/native_protocol_notices.py
!scripts/release/oci_payload_notices.py
!licenses/
licenses/**
!licenses/oci-payload/
licenses/oci-payload/**
!licenses/oci-payload/README.md
!licenses/oci-payload/adler2-2.0.1-MIT.txt
!licenses/oci-payload/crc32fast-1.5.2-MIT.txt
!licenses/oci-payload/flate2-1.1.10-MIT.txt
!licenses/oci-payload/miniz_oxide-0.9.1-MIT.txt
!licenses/oci-payload/simd-adler32-0.3.10-MIT.txt
# Public, committed certificate/SQL protocol fixtures needed only by the
# isolated production SQLite acceptance stage; never copied to runtime images.
!tests/
tests/**
!tests/fixtures/
tests/fixtures/**
!tests/fixtures/**
!tests/support/
tests/support/**
!tests/support/mod.rs
!tests/support/runtime_class_guard.rs
!tests/worker_support/
tests/worker_support/**
!tests/worker_support/commit_proxy.rs
!tests/nodeguard_journal_native.rs
!tests/termination_credentials.rs
!deploy/admission/
deploy/admission/**
!deploy/admission/config.example.json
!deploy/keycloak/
deploy/keycloak/**
!deploy/keycloak/realm.template.json
!deploy/observability/
deploy/observability/**
!deploy/observability/versions.lock.json

# Reviewed public console build inputs; no browser secrets, .env or test data.
!console/
console/**
!console/package.json
!console/package-lock.json
!console/index.html
!console/tsconfig.json
!console/vite.config.ts
!console/src/
console/src/**
!console/src/**
!sdk/
sdk/**
!sdk/typescript/
sdk/typescript/**
!sdk/typescript/src/
sdk/typescript/src/**
!sdk/typescript/src/schema.d.ts
!sdk/typescript/src/resource-observation.ts
!sdk/typescript/src/events.ts
!sdk/typescript/src/event-message.ts
!sdk/typescript/src/sse.ts
!sdk/typescript/src/transport.ts
!deploy/console/
deploy/console/**
!deploy/console/Dockerfile
!console/scripts/
console/scripts/**
!console/scripts/prepare-assets.mjs
!console/release-assets/
console/release-assets/**
!console/release-assets/bundle-manifest.json
!console/release-assets/assets/
console/release-assets/assets/**
!console/release-assets/assets/*.js
!console/release-assets/assets/*.css

!console/release-assets/npm-inventory/
console/release-assets/npm-inventory/**
!console/release-assets/npm-inventory/*/
console/release-assets/npm-inventory/*/**
!console/release-assets/npm-inventory/*/package.json
!console/release-assets/npm-inventory/*/package-lock.json

# Fixed RuntimeClass admission contract is compiled into the runtime verifier.
!deploy/runtime-class-guard/
deploy/runtime-class-guard/**
!deploy/runtime-class-guard/guard.json

# These private/generated paths stay excluded even inside allowed source trees.
**/node_modules
**/node_modules/**
**/.git
**/.git/**
**/.local
**/.local/**
**/.aws
**/.aws/**
**/.ssh
**/.ssh/**
**/.docker
**/.docker/**
**/.codex
**/.codex/**
**/.agents
**/.agents/**
**/target
**/target/**
**/__pycache__
**/__pycache__/**
**/.env
**/.env.*
